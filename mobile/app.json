{
  "expo": {
    "name": "QJSC Hospital",
    "slug": "qjsc-hospital",
    "scheme": "qjsc",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.qjsc.hospital",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "QJSC connects to the hospital Windows PC over the hospital's private Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "QJSC may use the camera when a supported hospital workflow requests image capture."
      }
    },
    "android": {
      "package": "pk.qjsc.hospital",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}